# Matholy Multilingual AI Backend — Environment Variables
# Copy this file to .env and customize

# --- Translation Provider Configuration ---

# MyMemory API (free, anonymous: 5000 chars/day; with email: 50000 chars/day)
# Set your email for higher rate limits (optional)
MYMEMORY_EMAIL=

# LibreTranslate (optional, requires self-hosted instance or API key)
# Public instance: https://libretranslate.com (heavily rate-limited)
# Self-host: docker run -p 5000:5000 libretranslate/libretranslate
LIBRETRANSLATE_URL=https://libretranslate.com
LIBRETRANSLATE_API_KEY=

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./matholy_db.sqlite

# --- Optional: GPU LLM for Chat/Tutor Mode ---
# These are only needed if you have a CUDA GPU for the AI chat feature.
# Translation works WITHOUT these via Argos/MyMemory/LibreTranslate providers.
# DEFAULT_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
# LORA_ADAPTER_PATH=./models/qlora_adapter
# USE_QUANTIZATION=True
# DEVICE=cuda
